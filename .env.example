# Provider API keys — set only the ones your config.yaml actually uses.
# sentinel-prime is provider-agnostic; DSPy reads these from the environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# OpenAI endpoint tuning (optional).
# OPENAI_MODEL: model string passed to DSPy/litellm, e.g. openai/gpt-5.6-luna
# OPENAI_BASE_URL: set only for a custom/proxy endpoint (blank -> api.openai.com)
OPENAI_MODEL=openai/gpt-5.6-luna
OPENAI_BASE_URL=
